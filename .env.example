# Gemini is preferred when configured. Never put a real key in this file.
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # if both Google key variables are set, this takes precedence
# Free-tier default; change only if you intend to use another model/tier.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic-compatible fallback, used only when no Gemini key is configured:
LLM_API_KEY=
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-5.5
